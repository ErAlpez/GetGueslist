generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MANAGER
  CHECKIN
  VIEWER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum EventFormat {
  PHYSICAL
  VIRTUAL
  HYBRID
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum AttendeeCategory {
  VIP
  SPEAKER
  SPONSOR
  ORGANIZER
  MEDIA
  GENERAL
  STAFF
  VOLUNTEER
  GUEST
  WALK_IN
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum AttendanceAction {
  CHECK_IN
  CHECK_OUT
}

model user {
  id                    String                @id
  name                  String
  email                 String                @unique
  emailVerified         Boolean               @default(false)
  image                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sessions              session[]
  accounts              account[]
  ownedWorkspaces       Workspace[]           @relation("WorkspaceOwner")
  memberships           WorkspaceMember[]
  attendanceLogs        AttendanceLog[]       @relation("AttendanceOperator")
  notificationViews     NotificationView[]
  mobileCheckinAccesses MobileCheckinAccess[] @relation("MobileCheckinAccessCreator")

  @@map("users")
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Workspace {
  id                    String                @id @default(cuid())
  name                  String
  slug                  String                @unique
  logoUrl               String?
  contactEmail          String?
  contactPhone          String?
  organizationType      String?
  address               String?
  timezone              String                @default("Asia/Manila")
  ownerId               String
  owner                 user                  @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members               WorkspaceMember[]
  subscription          Subscription?
  events                Event[]
  attendees             Attendee[]
  attendanceLogs        AttendanceLog[]
  activityLogs          ActivityLog[]
  invitations           WorkspaceInvitation[]
  checkinDevices        CheckinDevice[]
  mobileCheckinAccesses MobileCheckinAccess[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(VIEWER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        user          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  description String
  roles       RolePermission[]
}

model RolePermission {
  id           String        @id @default(cuid())
  role         WorkspaceRole
  permissionId String
  permission   Permission    @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(VIEWER)
  tokenHash   String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId, expiresAt])
}

model Plan {
  id                    String         @id @default(cuid())
  code                  String         @unique
  name                  String
  description           String?
  monthlyPriceCents     Int?
  yearlyPriceCents      Int?
  activeEventLimit      Int?
  attendeePerEventLimit Int?
  features              Json
  isActive              Boolean        @default(true)
  subscriptions         Subscription[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}

model Subscription {
  id                     String                 @id @default(cuid())
  workspaceId            String                 @unique
  planId                 String
  status                 SubscriptionStatus     @default(ACTIVE)
  billingPeriodStart     DateTime               @default(now())
  billingPeriodEnd       DateTime?
  renewalDate            DateTime?
  provider               String                 @default("manual")
  providerCustomerId     String?
  providerSubscriptionId String?                @unique
  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                   Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices               SubscriptionInvoice[]
  paymentMethods         BillingPaymentMethod[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([planId, status])
}

model SubscriptionInvoice {
  id             String       @id @default(cuid())
  subscriptionId String
  amountCents    Int
  currency       String       @default("PHP")
  status         String
  invoiceUrl     String?
  issuedAt       DateTime     @default(now())
  paidAt         DateTime?
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, issuedAt])
}

model BillingPaymentMethod {
  id                      String       @id @default(cuid())
  subscriptionId          String
  providerPaymentMethodId String       @unique
  brand                   String?
  last4                   String?
  expirationMonth         Int?
  expirationYear          Int?
  isDefault               Boolean      @default(false)
  subscription            Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  createdAt               DateTime     @default(now())

  @@index([subscriptionId, isDefault])
}

model Event {
  id                    String                @id @default(cuid())
  workspaceId           String
  name                  String
  slug                  String
  description           String                @default("")
  category              String
  type                  String
  format                EventFormat
  visibility            EventVisibility       @default(PRIVATE)
  status                EventStatus           @default(DRAFT)
  startsAt              DateTime
  endsAt                DateTime
  timezone              String                @default("Asia/Manila")
  venue                 String?
  address               String?
  capacity              Int?
  registrationDeadline  DateTime?
  organizerName         String?
  contactEmail          String?
  contactPhone          String?
  coverImageUrl         String?
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settings              EventSettings?
  modules               EventModule[]
  registrations         EventRegistration[]
  ticketTypes           TicketType[]
  registrationForm      RegistrationForm?
  attendanceLogs        AttendanceLog[]
  checkinDevices        CheckinDevice[]
  mobileCheckinAccesses MobileCheckinAccess[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  archivedAt            DateTime?

  @@unique([workspaceId, slug])
  @@index([workspaceId, status, startsAt])
  @@index([workspaceId, createdAt])
}

model EventSettings {
  id                String   @id @default(cuid())
  eventId           String   @unique
  allowRegistration Boolean  @default(true)
  allowWaitlist     Boolean  @default(false)
  requireApproval   Boolean  @default(false)
  customBranding    Json?
  event             Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedAt         DateTime @updatedAt
}

model EventModule {
  id        String   @id @default(cuid())
  eventId   String
  key       String
  enabled   Boolean  @default(false)
  settings  Json?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, key])
  @@index([eventId, enabled])
}

model Attendee {
  id            String              @id @default(cuid())
  workspaceId   String
  firstName     String
  lastName      String
  email         String?
  phone         String?
  company       String?
  position      String?
  internalNotes String?
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([workspaceId, email])
  @@index([workspaceId, lastName, firstName])
}

model EventRegistration {
  id                 String               @id @default(cuid())
  eventId            String
  attendeeId         String
  category           AttendeeCategory     @default(GENERAL)
  age                Int?
  gender             String?
  rsvpStatus         RSVPStatus           @default(PENDING)
  paymentStatus      PaymentStatus        @default(NOT_REQUIRED)
  registrationSource String               @default("manual")
  registeredAt       DateTime             @default(now())
  ticketTypeId       String?
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee           Attendee             @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ticketType         TicketType?          @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  ticket             Ticket?
  answers            RegistrationAnswer[]
  attendanceLogs     AttendanceLog[]

  @@unique([eventId, attendeeId])
  @@index([eventId, registeredAt])
  @@index([eventId, category, rsvpStatus])
}

model TicketType {
  id            String              @id @default(cuid())
  eventId       String
  name          String
  capacity      Int?
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  createdAt     DateTime            @default(now())

  @@index([eventId])
}

model Ticket {
  id             String            @id @default(cuid())
  displayId      String            @unique @default(dbgenerated("next_ticket_display_id()"))
  registrationId String            @unique
  tokenHash      String            @unique
  status         TicketStatus      @default(ACTIVE)
  expiresAt      DateTime?
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model TicketDisplayIdReservation {
  id String @id
}

model AttendanceLog {
  id             String            @id @default(cuid())
  workspaceId    String
  eventId        String
  registrationId String
  ticketId       String?
  action         AttendanceAction
  method         String
  deviceId       String?
  operatorId     String?
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event          Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registration   EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  ticket         Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  operator       user?             @relation("AttendanceOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@unique([ticketId, action])
  @@index([workspaceId, eventId, createdAt])
  @@index([registrationId, createdAt])
}

model CheckinDevice {
  id          String    @id @default(cuid())
  workspaceId String
  eventId     String?
  deviceId    String
  name        String?
  lastSeenAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, deviceId])
  @@index([eventId])
}

model MobileCheckinAccess {
  id               String    @id @default(cuid())
  workspaceId      String
  eventId          String
  createdById      String
  deviceName       String
  pairingTokenHash String    @unique
  pairingExpiresAt DateTime
  pairedAt         DateTime?
  sessionTokenHash String?   @unique
  sessionExpiresAt DateTime?
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event            Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy        user      @relation("MobileCheckinAccessCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventId, revokedAt])
  @@index([pairingExpiresAt])
  @@index([sessionExpiresAt])
}

model RegistrationForm {
  id        String                 @id @default(cuid())
  eventId   String                 @unique
  published Boolean                @default(false)
  event     Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  questions RegistrationQuestion[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model RegistrationQuestion {
  id       String               @id @default(cuid())
  formId   String
  label    String
  type     String
  required Boolean              @default(false)
  position Int
  options  Json?
  form     RegistrationForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers  RegistrationAnswer[]

  @@index([formId, position])
}

model RegistrationAnswer {
  id             String               @id @default(cuid())
  registrationId String
  questionId     String
  value          Json
  registration   EventRegistration    @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question       RegistrationQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
}

model ActivityLog {
  id          String             @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  workspace   Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  seenBy      NotificationView[]
  createdAt   DateTime           @default(now())

  @@index([workspaceId, createdAt])
  @@index([entityType, entityId])
}

model NotificationView {
  userId     String
  activityId String
  seenAt     DateTime    @default(now())
  user       user        @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity   ActivityLog @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@id([userId, activityId])
  @@index([activityId])
}
